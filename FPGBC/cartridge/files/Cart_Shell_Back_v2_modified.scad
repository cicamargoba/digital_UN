// Unidades: mm. X = ancho; Y = profundidad; Z = altura.
// Base exterior: Y positivo. Interior original: Y = 2.035.
// La ampliacion lateral engrosa hacia fuera; no ensancha la cavidad.
// Malla parametrizada; no reconstruccion de las operaciones CAD originales.

/* [Modificaciones] */
extra_base = 1.2; // [0:0.1:5]
extra_lateral = 2; // [0:0.1:3]

/* [Hidden] */
base_interior = 2.035;
base_exterior = 2.835;
lateral_interior = 26.755;
lateral_exterior = 28.555;

function limitar(v) = min(1, max(0, v));
function modificar(p) = [
    p[0] + sign(p[0]) * extra_lateral *
        limitar((abs(p[0]) - lateral_interior) /
                (lateral_exterior - lateral_interior)),
    p[1] + extra_base * limitar((p[1] - base_interior) /
                               (base_exterior - base_interior)),
    p[2]
];

